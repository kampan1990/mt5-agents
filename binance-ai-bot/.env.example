# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (สูง = คิดลึกขึ้น แต่แพงและช้าขึ้น)
LLM_EFFORT=medium

# ---- Binance USDT-M Futures ----
# testnet = Demo Trading (เงินปลอม) | live = เงินจริง (ต้องใส่ --confirm-live ด้วย)
BINANCE_ENV=testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=
# ใส่เพื่อบังคับ URL เอง (เช่น https://testnet.binancefuture.com)
# BINANCE_BASE_URL=

# ---- Trading ----
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT
INTERVAL=1h
LEVERAGE=3
DRY_RUN=true

# ---- Risk (บังคับทุก order) ----
RISK_PER_TRADE_PCT=1.0
MAX_DRAWDOWN_PCT=15
DAILY_LOSS_LIMIT_PCT=4
MAX_OPEN_POSITIONS=2
MIN_CONFIDENCE=0.6
MIN_REWARD_RISK=1.5

# ---- State ----
# เก็บ equity สูงสุด/ขาดทุนต้นวัน/สถานะหยุดเทรด ลบไฟล์นี้เพื่อรีเซ็ตหลังหยุดเพราะ Max Drawdown
STATE_FILE=data/risk_state.json
