# XAUGLM bridge configuration
# Copy this file to ".env" in the same directory and fill in real values.
# NEVER commit the real ".env" file (it holds your GLM API key).

# --- GLM (Zhipu AI) ---------------------------------------------------------
GLM_API_KEY=your-zhipu-api-key-here
GLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_MODEL=glm-4-plus
GLM_REQUEST_TIMEOUT_SECONDS=10
GLM_MAX_RETRIES=3
GLM_BACKOFF_BASE_SECONDS=1
GLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
GLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# --- MT5 Common Files folder -------------------------------------------------
# Leave blank to auto-detect on Windows (%APPDATA%\MetaQuotes\Terminal\Common\Files).
# Set explicitly if auto-detection doesn't apply on your setup (non-Windows host,
# non-standard install, bridge running on a different machine than the terminal).
MT5_COMMON_FILES_PATH=

# Subfolder under Common\Files that all bridge<->EA files live in. Must match
# the EA's Inp*FilePath inputs (which all start with "XAUGLM\").
SIGNAL_SUBFOLDER=XAUGLM

# --- Symbol / timing ---------------------------------------------------------
SYMBOL=XAUUSD
POLL_INTERVAL_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=20
# Informational only (should match the EA's InpSignalTimeoutSeconds so the
# operator can reason about both sides of the contract together).
SIGNAL_TIMEOUT_SECONDS=60

# --- News filter (bridge-side; EA also has its own independent check) -------
NEWS_FILTER_ENABLED=true
NEWS_BUFFER_MINUTES=30

# --- Safety escalation --------------------------------------------------------
# If the GLM circuit breaker opens this many times in a row (persistent
# failure), the bridge writes kill_switch.flag itself. Per policy this file is
# NEVER auto-cleared — an operator must investigate and delete it manually.
KILL_SWITCH_ON_REPEATED_CB_FAILURES=10

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
# Leave blank to default to <signal_dir>/logs/audit.jsonl
AUDIT_LOG_PATH=
