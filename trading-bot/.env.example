PORT=3000

# ── โหมด ──────────────────────────────────────────
# PAPER = จำลองพอร์ต (แนะนำให้รันอย่างน้อย 2-4 สัปดาห์ก่อน)
# LIVE  = ส่งคำสั่งให้ EA บน MT5 เปิด order จริง
TRADING_MODE=PAPER
MOCK_DATA=false                 # true = ใช้ราคาจำลอง (ทดสอบโดยไม่ต่อเน็ต)

# ── ตลาด ──────────────────────────────────────────
SYMBOLS=XAUUSD,EURUSD,BTCUSD     # XAUUSD,EURUSD,GBPUSD,USDJPY,US30,NAS100,SP500,BTCUSD,ETHUSD
TIMEFRAME=1h                    # 15m | 30m | 1h | 4h | 1d
CYCLE_CRON=*/30 * * * *         # รันทุก 30 นาที

# ── AI (Claude) ───────────────────────────────────
# ไม่ใส่ = Strategy ใช้ rule-based (EMA + RSI) และข้ามการวิเคราะห์ข่าว
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
NEWS_FEEDS=https://www.fxstreet.com/rss/news,https://feeds.content.dowjones.io/public/rss/mw_topstories
NEWS_CACHE_MINUTES=30

# ── Risk ──────────────────────────────────────────
RISK_PER_TRADE_PCT=1            # เพดานบังคับ 2%
MAX_DRAWDOWN_PCT=15             # เกินแล้วหยุดเทรดจนกว่าจะกด reset
DAILY_LOSS_LIMIT_PCT=4
MAX_OPEN_POSITIONS=3
MIN_CONFIDENCE=0.65
MIN_RISK_REWARD=1.2
MAX_LOT=5
PAPER_START_BALANCE=10000

# ── Security ──────────────────────────────────────
# สุ่มยาว ๆ เช่น: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=                    # ใช้กดปุ่มบน dashboard
EA_TOKEN=                       # ใส่ใน input ของ EA บน MT5
EA_HEARTBEAT_STALE_SEC=300
DB_PATH=trading.db
